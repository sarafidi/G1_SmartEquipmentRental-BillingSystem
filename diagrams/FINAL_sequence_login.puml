@startuml Login

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam roundcorner 8
skinparam stereotypePosition bottom
skinparam ParticipantPadding 40

' ═══════════════════════════════════════════════════
' PARTICIPANTS
' 7 lifelines: LoginDialog, UserController, Facade,
'              UserManager, User (domain obj),
'              HashUtil, SessionManager, DataStore
' ═══════════════════════════════════════════════════
  participant "LoginDialog" as View <<view>>

  participant "UserController" as Ctrl <<controller>>

  participant "RentalSystemFacade" as Facade <<Facade>>
  participant "UserManager"                as UserMgr <<model>>

  participant "User\n(Student/Staff, incl. Admin)" as UserObj <<domain obj>>

  participant "HashUtil" as Hash <<util>>
  participant "SessionManager" as Session <<Singleton>>
  participant "DataStore" as DS <<Singleton>>

' ═══════════════════════════════════════════════════
' MESSAGE FLOW
' ═══════════════════════════════════════════════════

' Step 1
View -> Ctrl : onLoginClick(userId, password)
activate View
activate Ctrl

' alt: empty fields
group alt [empty userId or password]
  Ctrl --> View : show validation error
end

' Step 2
Ctrl -> Facade : login(userId, password)
activate Facade

' Step 3
Facade -> UserMgr : authenticate(userId, password)
activate UserMgr

' Step 4 — lookup user
note over UserMgr : findById(userId)

group alt [user not found]
  UserMgr --> Facade : return null
  Facade --> Ctrl : return null
  Ctrl --> View : show "invalid credentials"
end

' Step 5
UserMgr -> UserObj : checkPassword(password)
activate UserObj

' Step 6 — delegate hash comparison
UserObj -> Hash : verify(password, storedHash)
activate Hash
Hash --> UserObj : return boolean
deactivate Hash

UserObj --> UserMgr : return boolean
deactivate UserObj

group alt [password mismatch]
  UserMgr --> Facade : return null
  Facade --> Ctrl : return null
  Ctrl --> View : show "invalid credentials"
end

' Step 7
UserMgr --> Facade : return user
deactivate UserMgr

|||
Facade -> Session : SessionManager.getInstance()\n.setCurrentUser(user)
activate Session
note over Session : store currentUser\nfor this application run
Session --> Facade : ok
deactivate Session
|||

' Step 9
Facade --> Ctrl : return user
deactivate Facade

' Step 10
Ctrl --> View : return success (boolean)
deactivate Ctrl

' Step 11
note over View : close dialog\nlaunch MainFrame\n(route by user.getUserType())
deactivate View

note over DS : Users were already loaded into\nUserManager at startup via\nDataStore.getInstance().loadUsers()

@enduml