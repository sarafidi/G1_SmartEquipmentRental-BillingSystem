@startuml Login

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam roundcorner 8
skinparam shadowing false
skinparam stereotypePosition bottom
skinparam ParticipantPadding 40

skinparam participant {
  BackgroundColor #FAFAFA
  BorderColor     #888888
  FontColor       #1A1A1A
  FontSize        12
}

skinparam sequence {
  ArrowColor              #444441
  ArrowFontSize           12
  ArrowFontColor          #333333
  LifeLineBorderColor     #AAAAAA
  LifeLineBackgroundColor #F5F5F5
  GroupBackgroundColor    #EAF4FB
  GroupBorderColor        #3B8BD4
  GroupFontColor          #0C447C
  GroupFontSize           12
  NoteBackgroundColor     #FFF8E8
  NoteBorderColor         #AAAAAA
  NoteFontSize            12
}

actor "User" as Actor
participant "LoginDialog" as View <<view>>
participant "UserController" as Ctrl <<controller>>
participant "RentalSystemFacade" as Facade <<Facade>>
participant "UserManager" as UserMgr <<model>>
participant "User\n(Student/Staff, incl. Admin)" as UserObj <<domain obj>>
participant "HashUtil" as Hash <<util>>
participant "SessionManager" as Session <<Singleton>>

' ===================================================
' MESSAGE FLOW
' ===================================================

Actor -> View : onLoginClick(userId, password)
activate View

note over View : check if userId or password is empty
alt empty fields
  View --> Actor : show validation error
end

View -> Ctrl : login(userId, password)
activate Ctrl

' Controller calls Facade
Ctrl -> Facade : login(userId, password)
activate Facade

' Facade authenticates
Facade -> UserMgr : authenticate(userId, password)
activate UserMgr

' UserManager looks up user
UserMgr -> UserMgr : findById(userId)

alt user == null
  UserMgr --> Facade : return null
else user != null
  ' User checks password
  UserMgr -> UserObj : checkPassword(password)
  activate UserObj
  UserObj -> Hash : verify(password, storedHash)
  activate Hash
  Hash --> UserObj : return match (boolean)
  deactivate Hash
  UserObj --> UserMgr : return match (boolean)
  deactivate UserObj
  
  alt password match
    UserMgr --> Facade : return user
  else password mismatch
    UserMgr --> Facade : return null
  end
end
deactivate UserMgr

' Facade saves current session
alt user != null
  Facade -> Session : setCurrentUser(user)
  activate Session
  Session --> Facade : ok
  deactivate Session
end

Facade --> Ctrl : return user
deactivate Facade

Ctrl --> View : return success (boolean)
deactivate Ctrl

alt success is true (user != null)
  note over View : close dialog\nlaunch MainFrame\n(route by user.getUserType())
  View --> Actor : route to MainFrame screen
else success is false (user == null)
  note over View : show warning dialog\n"Invalid Username or Password"
  View --> Actor : show error dialog popup
end
deactivate View

@enduml