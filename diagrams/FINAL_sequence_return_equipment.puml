@startuml ReturnEquipment

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam roundcorner 8
skinparam shadowing false
skinparam stereotypePosition bottom

skinparam participant {
  BackgroundColor #FAFAFA
  BorderColor     #888888
  FontColor       #1A1A1A
  FontSize        12
}

skinparam sequence {
  ArrowColor              #444441
  ArrowFontSize           11
  ArrowFontColor          #333333
  LifeLineBorderColor     #AAAAAA
  LifeLineBackgroundColor #F5F5F5
  GroupBackgroundColor    #EAF4FB
  GroupBorderColor        #3B8BD4
  GroupFontColor          #0C447C
  GroupFontSize           11
  NoteBackgroundColor     #FFF8E8
  NoteBorderColor         #AAAAAA
  NoteFontSize            11
}

' ═══════════════════════════════════════════════════
' PARTICIPANTS — matches visual diagram 3
' 6 lifelines: RentalPanel, RentalController, Facade,
'              RentalManager, PenaltyRule, DataStore
' ═══════════════════════════════════════════════════
box "src/view" #EAF4FB
  participant "RentalPanel" as View <<view>>
end box

box "src/controller" #EAF7EA
  participant "RentalController" as Ctrl <<controller>>
end box

box "Design Pattern: Facade" #E3EEF9
  participant "RentalSystemFacade" as Facade <<Facade>>
  participant "RentalManager" as RentMgr <<model>>
end box

box "src/model — Strategies" #FDF5E6
  participant "PenaltyRule\n(Late/Damage)" as Penalty <<interface>>
end box

box "src/util" #F0F0FF
  participant "DataStore" as DS <<Singleton>>
end box

' ═══════════════════════════════════════════════════
' MESSAGE FLOW — matches visual diagram 3
' ═══════════════════════════════════════════════════

' Step 1
View -> Ctrl : onReturnClick(rentalId, condition)
activate View
activate Ctrl

' Step 2
Ctrl -> Facade : returnEquipment(rentalId, condition)
activate Facade

' alt: invalid input
group alt [invalid input]
  Ctrl --> View : show validation error
end

' Step 3
Facade -> RentMgr : closeRental(rentalId, condition)
activate RentMgr

' Step 4 — find rental
note over RentMgr : findById(rentalId)

' alt: rental not found
group alt [rental not found]
  RentMgr --> Facade : return error
end

' Step 5
note over RentMgr : rental.setReturnDate(today)

' Step 6
note over RentMgr : rental.isOverdue()

' ── alt: overdue OR damaged ──────────────────────
group alt [overdue OR condition = damaged]

  ' Step 7
  RentMgr -> Penalty : computePenalty(rental)
  activate Penalty

  ' Step 8
  note over Penalty : lateDays × penaltyRatePerDay\nOR\ndamageMultiplier × dailyRate

  ' Step 9
  Penalty --> RentMgr : return penaltyAmt
  deactivate Penalty
|||
else [on time and good condition]
  note over RentMgr : penaltyAmt = 0.0
end

' Step 10
note over RentMgr : rental.setStatus(RETURNED)

' Step 11
RentMgr -> Facade : equipment.setAvailable(true)

' Step 12 — persist rentals
RentMgr -> DS : DataStore.getInstance().saveRentals(rentals)
activate DS
note over DS : write to JSON
DS --> RentMgr : saved
deactivate DS
|||

' Step 14 — persist equipment
Facade -> DS : DataStore.getInstance().saveEquipment(list)
activate DS
note over DS : write to JSON
DS --> Facade : saved
deactivate DS

' Step 15
RentMgr --> Facade : return rental
deactivate RentMgr

' Step 16
Facade --> Ctrl : return rental
deactivate Facade

' Step 17
Ctrl --> View : return rental
deactivate Ctrl

' Step 18
note over View : refreshTable()\nshow penalty summary
deactivate View

@enduml