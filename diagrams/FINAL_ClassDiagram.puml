@startuml SmartEquipmentRentalSystem

' ═══════════════════════════════════════════════════
' SKIN & STYLE
' ═══════════════════════════════════════════════════
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classFontSize 13
skinparam classAttributeFontSize 11
skinparam classStereotypeFontSize 10
skinparam roundcorner 8
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 100
skinparam ranksep 150

skinparam class {
  BackgroundColor #FAFAFA
  BorderColor     #888888
  HeaderBackgroundColor #E8EDF2
  FontColor       #1A1A1A
  AttributeFontColor #333333
}

skinparam package {
  BackgroundColor #F5F5F5
  BorderColor     #AAAAAA
  FontColor       #333333
  FontStyle       bold
}

' ═══════════════════════════════════════════════════
' ENUMERATIONS
' ═══════════════════════════════════════════════════
package "Enumerations" #FFF8E8 {

  enum RentalStatus {
    ACTIVE
    RETURNED
    OVERDUE
    CANCELLED
  }

  enum UserType {
    STUDENT
    FINAL_YEAR_STUDENT
    STAFF
    ADMIN
  }

}

' ═══════════════════════════════════════════════════
' VIEW LAYER  [src/view]
' ═══════════════════════════════════════════════════
package "src/view" #EAF4FB {

  class MainFrame {
    - currentPanel: JPanel
    --
    + showEquipmentPanel()
    + showRentalPanel()
    + showBillPanel()
    + showUserPanel()
  }

  class LoginDialog {
    - userIdField: JTextField
    - passwordField: JPasswordField
    --
    + onLoginClick()
  }

  class UserPanel {
    - userTable: JTable
    --
    + refreshTable()
    + onAddUserClick()
    + onRemoveUserClick()
  }

  class EquipmentPanel {
    - equipmentTable: JTable
    - searchField: JTextField
    --
    + refreshTable()
    + onSearchClick()
    + onAddEquipmentClick()
    + onRemoveEquipmentClick()
  }

  class RentalPanel {
    - rentalTable: JTable
    - daysField: JTextField
    --
    + onRentClick()
    + onReturnClick()
    + refreshTable()
  }

  class BillPanel {
    - billArea: JTextArea
    --
    + displayBill(bill: Bill)
    + onPrintClick()
  }

}

' ═══════════════════════════════════════════════════
' CONTROLLER LAYER  [src/controller]
' ═══════════════════════════════════════════════════
package "src/controller" #EAF7EA {

  class EquipmentController {
    - facade: RentalSystemFacade
    --
    + handleAddEquipment(name: String, category: String, rate: double)
    + handleRemoveEquipment(equipId: String): void
    + handleSearch(query: String): List
    + handleListAvailable(): List
  }

  class RentalController {
    - facade: RentalSystemFacade
    --
    + handleRent(userId: String, equipId: String, days: int)
    + handleReturn(rentalId: String, condition: String)
    + handleListRentals(): List
  }

  class BillingController {
    - facade: RentalSystemFacade
    --
    + handleGenerateBill(rentalId: String): Bill
    + handleGetBillHistory(userId: String): List
  }

  class UserController {
    - facade: RentalSystemFacade
    --
    + handleLogin(userId: String, password: String): User
    + handleAddUser(user: User): void
    + handleRemoveUser(userId: String): void
    + handleListUsers(): List
  }

}

' ═══════════════════════════════════════════════════
' DESIGN PATTERN 1: FAÇADE  [src/model]
' ═══════════════════════════════════════════════════
package "Design Pattern: Facade" #E3EEF9 {

  class RentalSystemFacade <<Facade>> {
    - equipmentMgr: EquipmentManager
    - rentalMgr: RentalManager
    - billingMgr: BillingManager
    - userMgr: UserManager
    --
    + rentEquipment(user: User, equip: Equipment, days: int): Rental
    + returnEquipment(rentalId: String, condition: String): void
    + generateBill(rentalId: String): Bill
    + listAvailableEquipment(): List
    + addEquipment(equip: Equipment): void
    + removeEquipment(equipId: String): void
    + getUserRentals(userId: String): List
    + login(userId: String, password: String): User
    + addUser(user: User): void
    + removeUser(userId: String): void
    + listUsers(): List
  }

  class EquipmentManager {
    - equipmentList: List<Equipment>
    --
    + addEquipment(e: Equipment): void
    + removeEquipment(id: String): void
    + findById(id: String): Equipment
    + listAvailable(): List<Equipment>
    + listAll(): List<Equipment>
  }

  class RentalManager {
    - rentals: List<Rental>
    - pricingStrategy: PricingStrategy
    - penaltyRules: List<PenaltyRule>
    --
    + createRental(user: User, equip: Equipment, days: int): Rental
    + closeRental(id: String, condition: String): Rental
    + findById(id: String): Rental
    + getRentalsByUser(userId: String): List<Rental>
  }

  class BillingManager {
    - bills: List<Bill>
    - rentalManager: RentalManager
    --
    + setRentalManager(mgr: RentalManager): void
    + generateBill(rental: Rental): Bill
    + findBillByRental(rentalId: String): Bill
    + getBillHistory(userId: String): List<Bill>
  }

  class UserManager {
    - users: List<User>
    --
    + addUser(u: User): void
    + removeUser(id: String): void
    + findById(id: String): User
    + listAll(): List<User>
    + authenticate(userId: String, password: String): User
  }

}

' ═══════════════════════════════════════════════════
' DOMAIN — EQUIPMENT HIERARCHY  [src/model]
' ═══════════════════════════════════════════════════
package "src/model — Equipment" #F5F0FA {

  abstract class Equipment <<abstract>> {
    - equipmentId: String
    - name: String
    - category: String
    - dailyRate: double
    - available: boolean
    --
    + {abstract} calculateRentalFee(days: int): double
    + getEquipmentId(): String
    + getName(): String
    + getCategory(): String
    + getDailyRate(): double
    + isAvailable(): boolean
    + setAvailable(status: boolean): void
  }

  class ElectronicsEquipment {
    - warrantyMonths: int
    --
    + calculateRentalFee(days: int): double
    + getWarrantyMonths(): int
  }

  class MediaEquipment {
    - requiresDeposit: boolean
    - depositAmount: double
    --
    + calculateRentalFee(days: int): double
    + isRequiresDeposit(): boolean
    + getDepositAmount(): double
  }

  class LabEquipment {
    - hazardLevel: int
    - requiresCertificate: boolean
    --
    + calculateRentalFee(days: int): double
    + getHazardLevel(): int
    + isRequiresCertificate(): boolean
  }

}

' ═══════════════════════════════════════════════════
' DOMAIN — USER HIERARCHY  [src/model]
' ═══════════════════════════════════════════════════
package "src/model — User" #FFF0F0 {

  abstract class User <<abstract>> {
    - userId: String
    - name: String
    - email: String
    - password: String
    - userType: UserType
    --
    + {abstract} getDiscountRate(): double
    + getUserId(): String
    + getName(): String
    + getUserType(): UserType
    + checkPassword(input: String): boolean
  }

  class Student {
    - studentId: String
    - yearOfStudy: int
    --
    + getDiscountRate(): double
    + isFinalYear(): boolean
    + getYearOfStudy(): int
  }

  class Staff {
    - staffId: String
    - department: String
    --
    + getDiscountRate(): double
    + getDepartment(): String
  }

}

' ═══════════════════════════════════════════════════
' DOMAIN — RENTAL & BILL  [src/model]
' ═══════════════════════════════════════════════════
package "                                                     src/model — Rental & Billing" #F0FAF0 {
  class Rental {
    - rentalId: String
    - user: User
    - equipment: Equipment
    - startDate: LocalDate
    - dueDate: LocalDate
    - returnDate: LocalDate
    - status: RentalStatus
    - condition: String
    --
    + isOverdue(): boolean
    + getDaysRented(): int
    + getDaysOverdue(): int
    + getRentalId(): String
    + getStatus(): RentalStatus
    + setReturnDate(date: LocalDate): void
    + setStatus(status: RentalStatus): void
  }

  ' ─────────────────────────────────────────────────
  ' DESIGN PATTERN 3: BUILDER applied to Bill
  ' Bill has many optional fields (discount, penalty)
  ' Builder constructs it step by step cleanly
  ' ─────────────────────────────────────────────────
  class Bill <<Builder>> {
    - billId: String
    - rentalId: String
    - baseRentalFee: double
    - discountAmount: double
    - penaltyAmount: double
    - netPayable: double
    - billDate: LocalDate
    --
    - Bill(builder: Builder)
    + computeNet(): double
    + printBill(): String
    + getBillId(): String
    + getNetPayable(): double
    + getBaseRentalFee(): double
    + getDiscountAmount(): double
    + getPenaltyAmount(): double
  }

  class "Bill.Builder" as BillBuilder {
    - billId: String
    - rentalId: String
    - baseRentalFee: double
    - discountAmount: double
    - penaltyAmount: double
    --
    + BillBuilder(rentalId: String)
    + baseRentalFee(fee: double): Builder
    + discountAmount(amt: double): Builder
    + penaltyAmount(amt: double): Builder
    + build(): Bill
  }

}

' ═══════════════════════════════════════════════════
' PRICING & PENALTY STRATEGIES  [src/model]
' ═══════════════════════════════════════════════════
package "src/model — Strategies" #FDF5E6 {

  interface PricingStrategy <<interface>> {
    + calculateFee(equip: Equipment, days: int): double
    + applyDiscount(user: User, fee: double): double
  }

  interface PenaltyRule <<interface>> {
    + computePenalty(rental: Rental): double
    + getRuleDescription(): String
  }

  class StandardPricing {
    --
    + calculateFee(equip: Equipment, days: int): double
    + applyDiscount(user: User, fee: double): double
  }

  class DiscountedPricing {
    - discountRate: double
    --
    + calculateFee(equip: Equipment, days: int): double
    + applyDiscount(user: User, fee: double): double
    + getDiscountRate(): double
  }

  class LatePenalty {
    - penaltyRatePerDay: double
    --
    + computePenalty(rental: Rental): double
    + getRuleDescription(): String
  }

  class DamagePenalty {
    - damageMultiplier: double
    --
    + computePenalty(rental: Rental): double
    + getRuleDescription(): String
  }

}

' ═══════════════════════════════════════════════════
' DESIGN PATTERN 2: SINGLETON + UTIL  [src/util]
' ═══════════════════════════════════════════════════
package "src/util" #F0F0FF {

  class DataStore <<Singleton>> {
    - {static} instance: DataStore
    - equipmentFilePath: String
    - rentalsFilePath: String
    - billsFilePath: String
    - usersFilePath: String
    --
    - DataStore()
    + {static} getInstance(): DataStore
    + saveEquipment(list: List<Equipment>): void
    + loadEquipment(): List<Equipment>
    + saveRentals(list: List<Rental>): void
    + loadRentals(): List<Rental>
    + saveBills(list: List<Bill>): void
    + loadBills(): List<Bill>
    + saveUsers(list: List<User>): void
    + loadUsers(): List<User>
  }

  class JsonHelper {
    --
    + {static} toJson(obj: Object): String
    + {static} fromJson(json: String, type: Type): Object
  }

  class Validator {
    --
    + {static} isValidEmail(s: String): boolean
    + {static} isPositive(n: double): boolean
    + {static} isNotEmpty(s: String): boolean
    + {static} isValidDays(days: int): boolean
    + {static} passwordsMatch(pw: String, confirm: String): boolean
  }

  class HashUtil {
    --
    + {static} hash(plainText: String): String
    + {static} verify(plainText: String, hashed: String): boolean
  }

  class IDGenerator {
    --
    + {static} generateUserId(): String
    + {static} generateEquipmentId(): String
    + {static} generateRentalId(): String
    + {static} generateBillId(): String
    + {static} generateStudentId(): String
    + {static} generateStaffId(): String
  }

  class SessionManager <<Singleton>> {
    - {static} instance: SessionManager
    - currentUser: User
    --
    - SessionManager()
    + {static} getInstance(): SessionManager
    + login(user: User): void
    + logout(): void
    + getCurrentUser(): User
    + isLoggedIn(): boolean
  }

}

' ═══════════════════════════════════════════════════
' ENTRY POINT
' ═══════════════════════════════════════════════════
package "src" #F5F5F5 {

  class Main {
    --
    + {static} main(args: String[]): void
  }

}

' ── view → controller (dependency) ─────────────────
EquipmentPanel  ..>  EquipmentController
RentalPanel     ..>  RentalController
BillPanel       ..>  BillingController
UserPanel       ..>  UserController
LoginDialog     ..>  UserController

' MainFrame composes the main panels (composition)
MainFrame "1" *-- "1" EquipmentPanel
MainFrame "1" *-- "1" RentalPanel
MainFrame "1" *-- "1" BillPanel
MainFrame "1" *-- "1" UserPanel

' LoginDialog is a transient modal launched once at startup by Main
' (before MainFrame exists), not permanently composed — dependency only
Main ..> LoginDialog
Main ..> MainFrame

' ── controller → facade (association) ──────────────
EquipmentController "1" --> "1" RentalSystemFacade
RentalController    "1" --> "1" RentalSystemFacade
BillingController    "1" --> "1" RentalSystemFacade
UserController       "1" --> "1" RentalSystemFacade

' controllers use ValidationUtil (dependency)
RentalController    ..>  Validator
EquipmentController ..>  Validator
UserController      ..>  Validator
UserController      ..>  SessionManager

' ── facade → managers (dependency) ─────────────────
RentalSystemFacade ..> EquipmentManager
RentalSystemFacade ..> RentalManager
RentalSystemFacade ..> BillingManager
RentalSystemFacade ..> UserManager

' ── managers → domain (aggregation) ────────────────
EquipmentManager "1" o-- "0..*" Equipment
RentalManager    "1" o-- "0..*" Rental
BillingManager   "1" o-- "0..*" Bill
UserManager      "1" o-- "0..*" User

' ── managers → DataStore Singleton (dependency) ────
EquipmentManager ..> DataStore
RentalManager    ..> DataStore
BillingManager   ..> DataStore
UserManager      ..> DataStore
DataStore        ..> JsonHelper

' ── managers → ID generation (dependency) ──────────
EquipmentManager ..> IDGenerator
RentalManager    ..> IDGenerator
BillingManager   ..> IDGenerator
UserManager      ..> IDGenerator

' ── UserManager → password hashing (dependency) ────
UserManager ..> HashUtil

' ── RentalManager → strategies (dependency) ────────
RentalManager "1" ..> "1"    PricingStrategy
RentalManager "1" ...> "0..*" PenaltyRule

' ── BillingManager → RentalManager (setter injection) ──
' shares the same PricingStrategy/PenaltyRule instances
' rather than duplicating config; avoids circular Singleton calls
BillingManager ..> RentalManager : injected

' ── Equipment hierarchy (inheritance) ──────────────
Equipment <|-- ElectronicsEquipment : extends
Equipment <|-- MediaEquipment : extends
Equipment <|-- LabEquipment : extends

' ── User hierarchy (inheritance) ───────────────────
User <|-- Student
User <|-- Staff

' ── Strategy realization ────────────────────────────
PricingStrategy <|.. StandardPricing
PricingStrategy <|.. DiscountedPricing

PenaltyRule <|.. LatePenalty
PenaltyRule <|.. DamagePenalty

' ── Domain associations & multiplicities ───────────
' A user can have many rentals (aggregation)
User      "1"  o--  "0..*"  Rental

' An equipment item can appear in many rentals (association)
Equipment "1"  ---   "0..*"  Rental

' A rental owns exactly one bill (composition)
Rental    "1"  *-left-  "1"     Bill

' Builder creates Bill
BillBuilder ..> Bill : <<creates>>
Bill        +-- BillBuilder

' ── Enum usage (dependency) ─────────────────────────
Rental .up.> RentalStatus
User   .up.> UserType

'note "Actual Java package mapping:\nEquipment/ElectronicsEquipment/MediaEquipment/LabEquipment -> model.equipment\nUser/Student/Staff -> model.user (Admin = Staff built with UserType.ADMIN\nvia an overloaded constructor, not a separate class)\nRental, Bill -> model\nManagers + Facade -> model (or model.facade)\nPricingStrategy/PenaltyRule + impls -> strategy\nDataStore/JsonHelper/Validator/HashUtil/IDGenerator/SessionManager -> util\nUsed by DataStore's Class.forName(\"model.equipment.\" + type) and\nClass.forName(\"model.user.\" + type) for polymorphic Gson deserialization." as PackageNote

@enduml