@startuml ManageEquipment

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam roundcorner 8
skinparam shadowing false
skinparam stereotypePosition bottom
skinparam ParticipantPadding 40

skinparam participant {
  BackgroundColor #FAFAFA
  BorderColor     #888888
  FontColor       #1A1A1A
  FontSize        12
}

skinparam sequence {
  ArrowColor              #444441
  ArrowFontSize           12
  ArrowFontColor          #333333
  LifeLineBorderColor     #AAAAAA
  LifeLineBackgroundColor #F5F5F5
  GroupBackgroundColor    #EAF4FB
  GroupBorderColor        #3B8BD4
  GroupFontColor          #0C447C
  GroupFontSize           12
  NoteBackgroundColor     #FFF8E8
  NoteBorderColor         #AAAAAA
  NoteFontSize            12
}

actor "Admin" as Actor
participant "EquipmentPanel" as View <<view>>
participant "EquipmentController" as Ctrl <<controller>>
participant "RentalSystemFacade" as Facade <<Facade>>
participant "EquipmentManager" as EqMgr <<model>>
participant "Electronics/Media/Lab\nEquipment" as EqObj <<domain obj>>
participant "DataStore" as DS <<Singleton>>

' ===================================================
' ADD EQUIPMENT FLOW
' ===================================================
== Add Equipment Flow ==

Actor -> View : onAddClick()
activate View

note over View : Validate name, rate and options\nParse numeric rate

' Factory instantiation inside View
alt Category is Electronics
  View -> EqObj : new ElectronicsEquipment(id, name, rate, warranty)
  activate EqObj
  EqObj --> View : return Electronics object
  deactivate EqObj
else Category is Media
  View -> EqObj : new MediaEquipment(id, name, rate, hasDeposit, depositAmt)
  activate EqObj
  EqObj --> View : return Media object
  deactivate EqObj
else Category is Lab
  View -> EqObj : new LabEquipment(id, name, rate, hazardLevel, cert)
  activate EqObj
  EqObj --> View : return Lab object
  deactivate EqObj
end

View -> Ctrl : addEquipment(equipment)
activate Ctrl

Ctrl -> Facade : addEquipment(equipment)
activate Facade

Facade -> EqMgr : addEquipment(equipment)
activate EqMgr

note over EqMgr : Add equipment to list

EqMgr -> DS : saveEquipment()
activate DS
DS --> EqMgr : saved
deactivate DS

EqMgr --> Facade : done
deactivate EqMgr

Facade --> Ctrl : done
deactivate Facade

Ctrl --> View : return done
deactivate Ctrl

View -> View : refreshTable()
activate View
View -> Ctrl : listAllEquipment()
activate Ctrl
Ctrl -> Facade : listAllEquipment()
activate Facade
Facade -> EqMgr : listAll()
activate EqMgr
EqMgr --> Facade : return list
deactivate EqMgr
Facade --> Ctrl : return list
deactivate Facade
Ctrl --> View : return list
deactivate Ctrl
deactivate View
View --> Actor : show success popup & refresh table
deactivate View

|||
' ===================================================
' REMOVE EQUIPMENT FLOW
' ===================================================
== Remove Equipment Flow ==

Actor -> View : onRemoveClick(id)
activate View

View -> Ctrl : removeEquipment(id)
activate Ctrl

Ctrl -> Facade : removeEquipment(id)
activate Facade

Facade -> EqMgr : removeEquipment(id)
activate EqMgr

EqMgr -> EqMgr : findById(id)
note over EqMgr : Check availability\nRemove from list

EqMgr -> DS : saveEquipment()
activate DS
DS --> EqMgr : saved
deactivate DS

EqMgr --> Facade : done
deactivate EqMgr

Facade --> Ctrl : done
deactivate Facade

Ctrl --> View : return done
deactivate Ctrl

View -> View : refreshTable()
activate View
View -> Ctrl : listAllEquipment()
activate Ctrl
Ctrl -> Facade : listAllEquipment()
activate Facade
Facade -> EqMgr : listAll()
activate EqMgr
EqMgr --> Facade : return list
deactivate EqMgr
Facade --> Ctrl : return list
deactivate Facade
Ctrl --> View : return list
deactivate Ctrl
deactivate View
View --> Actor : show success popup & refresh table
deactivate View

@enduml