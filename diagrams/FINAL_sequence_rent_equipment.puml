@startuml RentEquipment

' ═══════════════════════════════════════════════════
' SKIN & STYLE
' ═══════════════════════════════════════════════════
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam roundcorner 8
skinparam shadowing false
skinparam stereotypePosition bottom
skinparam ParticipantPadding 40

skinparam participant {
  BackgroundColor #FAFAFA
  BorderColor     #888888
  FontColor       #1A1A1A
  FontSize        12
}

skinparam sequence {
  ArrowColor              #444441
  ArrowFontSize           12
  ArrowFontColor          #333333
  LifeLineBorderColor     #AAAAAA
  LifeLineBackgroundColor #F5F5F5
  GroupBackgroundColor    #EAF4FB
  GroupBorderColor        #3B8BD4
  GroupFontColor          #0C447C
  GroupFontSize           12
  NoteBackgroundColor     #FFF8E8
  NoteBorderColor         #AAAAAA
  NoteFontSize            12
}

' ═══════════════════════════════════════════════════
' PARTICIPANTS — exactly matching the visual diagram
' ═══════════════════════════════════════════════════
participant "RentalPanel" as View <<view>>
participant "RentalController" as Ctrl <<controller>>
participant "RentalSystemFacade" as Facade <<Facade>>
participant "EquipmentManager"             as EqMgr <<model>>
participant "RentalManager"               as RentMgr <<model>>
participant "Rental" as Rental <<domain obj>>
participant "Equipment" as EquipObj <<domain obj>>
participant "DataStore" as DS <<Singleton>>

' ═══════════════════════════════════════════════════
' MESSAGE FLOW — matches visual diagram step by step
' ═══════════════════════════════════════════════════

' Step 1
View -> Ctrl : onRentClick()
activate View
activate Ctrl

' Step 2
Ctrl -> Facade : rentEquipment(userId, equipId, days)
activate Facade

' alt: invalid input
group alt [invalid input]
  Ctrl --> View : show validation error
end

' Step 3
Facade -> EqMgr : findById(equipId)
activate EqMgr

' alt: not available
group alt [equipment not available]
  EqMgr --> Facade : return error
end

' Step 4 (implicit — availability check inside EqMgr)
note over EqMgr : check available

' Step 5
EqMgr --> Facade : return equipment
deactivate EqMgr

|||
' Step 6 — Facade delegates creation to RentalManager
Facade -> RentMgr : createRental(user, equipment, days)
activate RentMgr

' Step 7 — Check availability
note over RentMgr : check if equipment is available

' Step 8 — Instantiate Rental domain object
RentMgr -> Rental : new Rental(rentalId, user, equipment, LocalDate.now(), days)
activate Rental
note over Rental : set status ACTIVE
Rental --> RentMgr : return rental
deactivate Rental

' Step 9 — Mark equipment as rented
RentMgr -> EquipObj : setAvailable(false)
activate EquipObj
EquipObj --> RentMgr : ok
deactivate EquipObj

' Step 10 — Save updated lists via DataStore Singleton
RentMgr -> DS : saveEquipment()
activate DS
DS --> RentMgr : saved
deactivate DS

RentMgr -> DS : saveRental()
activate DS
DS --> RentMgr : saved
deactivate DS

' Step 11
RentMgr --> Facade : return rental
deactivate RentMgr

' Step 15
Facade --> Ctrl : return rental
deactivate Facade

' Step 16
Ctrl --> View : return rental
deactivate Ctrl

' Step 17
note over View : refreshTable()\nshow success message
deactivate View

@enduml