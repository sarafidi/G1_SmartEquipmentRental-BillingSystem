@startuml RentEquipment

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam roundcorner 8
skinparam shadowing false
skinparam stereotypePosition bottom
skinparam ParticipantPadding 40

skinparam participant {
  BackgroundColor #FAFAFA
  BorderColor     #888888
  FontColor       #1A1A1A
  FontSize        12
}

skinparam sequence {
  ArrowColor              #444441
  ArrowFontSize           12
  ArrowFontColor          #333333
  LifeLineBorderColor     #AAAAAA
  LifeLineBackgroundColor #F5F5F5
  GroupBackgroundColor    #EAF4FB
  GroupBorderColor        #3B8BD4
  GroupFontColor          #0C447C
  GroupFontSize           12
  NoteBackgroundColor     #FFF8E8
  NoteBorderColor         #AAAAAA
  NoteFontSize            12
}

actor "Student/Staff" as Actor
participant "RentalPanel" as View <<view>>
participant "Validator" as Val <<util>>
participant "RentalController" as Ctrl <<controller>>
participant "RentalSystemFacade" as Facade <<Facade>>
participant "SessionManager" as Session <<Singleton>>
participant "UserManager" as UserMgr <<model>>
participant "EquipmentManager" as EqMgr <<model>>
participant "RentalManager" as RentMgr <<model>>
participant "IDGenerator" as IDGen <<util>>
participant "Rental" as Rental <<domain obj>>
participant "Equipment" as EquipObj <<domain obj>>
participant "DataStore" as DS <<Singleton>>

' ===================================================
' MESSAGE FLOW
' ===================================================

Actor -> View : onRentClick()
activate View

' Validation in View
View -> Val : isNonEmpty(userId)
activate Val
Val --> View
deactivate Val

View -> Val : isNonEmpty(equipmentId)
activate Val
Val --> View
deactivate Val

View -> Val : isNonEmpty(daysStr)
activate Val
Val --> View
deactivate Val

View -> Val : isValidDays(days)
activate Val
Val --> View
deactivate Val

' View calls Controller
View -> Ctrl : rentEquipment(userId, equipmentId, days)
activate Ctrl

' Controller validation
Ctrl -> Val : isNonEmpty(userId)
activate Val
Val --> Ctrl
deactivate Val

Ctrl -> Val : isNonEmpty(equipmentId)
activate Val
Val --> Ctrl
deactivate Val

Ctrl -> Val : isValidDays(days)
activate Val
Val --> Ctrl
deactivate Val

' Security validation check
Ctrl -> Facade : getCurrentUser()
activate Facade
Facade -> Session : getCurrentUser()
activate Session
Session --> Facade : return loggedInUser
deactivate Session
Facade --> Ctrl : return loggedInUser
deactivate Facade

note over Ctrl : Validate logged-in user.\nIf STUDENT, verify they\nonly rent for their own userId.

' Controller calls Facade
Ctrl -> Facade : rentEquipment(userId, equipmentId, days)
activate Facade

' Facade looks up user
Facade -> UserMgr : findById(userId)
activate UserMgr
note over UserMgr : u -> u.getUserId().equalsIgnoreCase(userId)
UserMgr --> Facade : return user
deactivate UserMgr

' Facade looks up equipment
Facade -> EqMgr : findById(equipmentId)
activate EqMgr
note over EqMgr : e -> e.getEquipmentId().equalsIgnoreCase(equipmentId)
EqMgr --> Facade : return equipment
deactivate EqMgr

' Facade calls RentalManager
Facade -> RentMgr : createRental(user, equipment, days)
activate RentMgr

' RentalManager generates ID, instantiates Rental, and saves
RentMgr -> IDGen : generateRentalId()
activate IDGen
IDGen --> RentMgr : return rentalId
deactivate IDGen

RentMgr -> Rental : new Rental(rentalId, user, equipment, LocalDate.now(), days)
activate Rental
note over Rental : set status ACTIVE
Rental --> RentMgr : return rental
deactivate Rental

RentMgr -> EquipObj : setAvailable(false)
activate EquipObj
EquipObj --> RentMgr
deactivate EquipObj

RentMgr -> DS : saveEquipment()
activate DS
DS --> RentMgr : saved
deactivate DS

RentMgr -> DS : saveRental()
activate DS
DS --> RentMgr : saved
deactivate DS

RentMgr --> Facade : return rental
deactivate RentMgr

Facade --> Ctrl : return rental
deactivate Facade

Ctrl --> View : return rental
deactivate Ctrl

' Post-rental actions (alt block)
alt rental != null
  View -> View : refreshTable()
  activate View
  
  alt userType is ADMIN or STAFF
    View -> Ctrl : listAllRentals()
    activate Ctrl
    Ctrl -> Facade : listAllRentals()
    activate Facade
    Facade -> RentMgr : listAll()
    activate RentMgr
    RentMgr --> Facade : return rentalsList
    deactivate RentMgr
    Facade --> Ctrl : return rentalsList
    deactivate Facade
    Ctrl --> View : return rentalsList
    deactivate Ctrl
  else userType is STUDENT
    View -> Ctrl : getUserRentals(userId)
    activate Ctrl
    
    Ctrl -> Val : isNonEmpty(userId)
    activate Val
    Val --> Ctrl
    deactivate Val
    
    Ctrl -> Facade : getUserRentals(userId)
    activate Facade
    Facade -> RentMgr : getRentalsByUser(userId)
    activate RentMgr
    RentMgr --> Facade : return userRentals
    deactivate RentMgr
    Facade --> Ctrl : return userRentals
    deactivate Facade
    Ctrl --> View : return userRentals
    deactivate Ctrl
  end
  deactivate View
  View --> Actor : show success popup & refresh table
else rental == null
  View --> Actor : show error dialog popup
end
deactivate View

@enduml