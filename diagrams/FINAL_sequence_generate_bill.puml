@startuml GenerateBill

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam roundcorner 8
skinparam shadowing false
skinparam stereotypePosition bottom

skinparam participant {
  BackgroundColor #FAFAFA
  BorderColor     #888888
  FontColor       #1A1A1A
  FontSize        12
}

skinparam sequence {
  ArrowColor              #444441
  ArrowFontSize           11
  ArrowFontColor          #333333
  LifeLineBorderColor     #AAAAAA
  LifeLineBackgroundColor #F5F5F5
  GroupBackgroundColor    #EAF4FB
  GroupBorderColor        #3B8BD4
  GroupFontColor          #0C447C
  GroupFontSize           11
  NoteBackgroundColor     #FFF8E8
  NoteBorderColor         #AAAAAA
  NoteFontSize            11
}

' ═══════════════════════════════════════════════════
' PARTICIPANTS — matches visual diagram 2
' 7 lifelines: BillPanel, BillingController, Facade,
'              RentalManager, BillingManager,
'              Bill.Builder, DataStore
' ═══════════════════════════════════════════════════
box "src/view" #EAF4FB
  participant "BillPanel" as View <<view>>
end box

box "src/controller" #EAF7EA
  participant "BillingController" as Ctrl <<controller>>
end box

box "Design Pattern: Facade" #E3EEF9
  participant "RentalSystemFacade" as Facade <<Facade>>
  participant "RentalManager" as RentMgr <<model>>
  participant "BillingManager" as BillMgr <<model>>
end box

box "Design Pattern: Builder" #FDF5E6
  participant "Bill.Builder" as Builder <<Builder>>
end box

box "src/util" #F0F0FF
  participant "DataStore" as DS <<Singleton>>
end box

' ═══════════════════════════════════════════════════
' MESSAGE FLOW — matches visual diagram 2
' ═══════════════════════════════════════════════════

' Step 1
View -> Ctrl : onGenerateBillClick()
activate View
activate Ctrl

' Step 2
Ctrl -> Facade : generateBill(rentalId)
activate Facade

' Step 3 — Facade retrieves rental first
Facade -> RentMgr : findById(rentalId)
activate RentMgr

' alt: rental not found
group alt [rental not found]
  RentMgr --> Facade : return error
end

' Step 5
RentMgr --> Facade : return rental
deactivate RentMgr

|||
' Step 6
Facade -> BillMgr : generateBill(rental)
activate BillMgr

' Step 7 — BillingManager calculates components
note over BillMgr : calculateBaseFee()\n= equipment.dailyRate × days

' Step 8
note over BillMgr : user.getDiscountRate()\napply to base fee

' Step 9
note over BillMgr : rental.isOverdue()\n→ invoke PenaltyRule if true

|||
' ── Builder block (Steps 10–14) ─────────────────
BillMgr -> Builder : new Builder(rentalId)
activate Builder

BillMgr -> Builder : .baseRentalFee(fee)
BillMgr -> Builder : .discountAmount(disc)
BillMgr -> Builder : .penaltyAmount(pen)

' Step 14
BillMgr -> Builder : .build()
Builder --> BillMgr : return Bill
deactivate Builder

|||
' Step 16 — persist bill via Singleton
BillMgr -> DS : DataStore.getInstance()\n.saveBills(bills)
activate DS
note over DS : write to JSON
DS --> BillMgr : saved
deactivate DS

' Step 17
BillMgr --> Facade : return bill
deactivate BillMgr

' Step 18
Facade --> Ctrl : return bill
deactivate Facade

' Step 19
Ctrl --> View : return bill
deactivate Ctrl

' Step 20
note over View : displayBill(bill)\nshow breakdown:\nbase fee, discount,\npenalty, net payable
deactivate View

@enduml