@startuml GenerateBill

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam roundcorner 8
skinparam shadowing false
skinparam stereotypePosition bottom
skinparam ParticipantPadding 40

skinparam participant {
  BackgroundColor #FAFAFA
  BorderColor     #888888
  FontColor       #1A1A1A
  FontSize        12
}

skinparam sequence {
  ArrowColor              #444441
  ArrowFontSize           12
  ArrowFontColor          #333333
  LifeLineBorderColor     #AAAAAA
  LifeLineBackgroundColor #F5F5F5
  GroupBackgroundColor    #EAF4FB
  GroupBorderColor        #3B8BD4
  GroupFontColor          #0C447C
  GroupFontSize           12
  NoteBackgroundColor     #FFF8E8
  NoteBorderColor         #AAAAAA
  NoteFontSize            12
}

actor "Staff/Admin" as Actor
participant "BillPanel" as View <<view>>
participant "Validator" as Val <<util>>
participant "BillingController" as Ctrl <<controller>>
participant "RentalSystemFacade" as Facade <<Facade>>
participant "RentalManager" as RentMgr <<model>>
participant "BillingManager" as BillMgr <<model>>
participant "PenaltyRule" as Rule <<interface>>
participant "Bill.Builder" as Builder <<Builder>>
participant "DataStore" as DS <<Singleton>>

' ===================================================
' MESSAGE FLOW
' ===================================================

Actor -> View : onGenerateClick()
activate View

' View input validation
View -> Val : isNonEmpty(rentalId)
activate Val
Val --> View
deactivate Val

' View calls Controller
View -> Ctrl : generateBill(rentalId)
activate Ctrl

' Controller input validation
Ctrl -> Val : isNonEmpty(rentalId)
activate Val
Val --> Ctrl
deactivate Val

' Controller calls Facade
Ctrl -> Facade : generateBill(rentalId)
activate Facade

' Facade retrieves rental first
Facade -> RentMgr : findById(rentalId)
activate RentMgr

alt rental not found
  RentMgr --> Facade : return null
end

RentMgr --> Facade : return rental
deactivate RentMgr

|||
' Facade delegates to BillingManager
Facade -> BillMgr : generateBill(rental)
activate BillMgr

' Calculate components
note over BillMgr : calculateBaseFee() = equipment.dailyRate * days
note over BillMgr : user.getDiscountRate() applied to base fee

' Retrieve penalty strategies
BillMgr -> RentMgr : getPenaltyRules()
activate RentMgr
RentMgr --> BillMgr : return rules
deactivate RentMgr

loop for each PenaltyRule rule in rules
  BillMgr -> Rule : computePenalty(rental)
  activate Rule
  Rule --> BillMgr : return penaltyAmt
  deactivate Rule
  note over BillMgr : if rule instanceof LatePenalty:\n  latePenalty += penaltyAmt\nelse if rule instanceof DamagePenalty:\n  damagePenalty += penaltyAmt
end

|||
' Builder block
BillMgr -> Builder : new Builder(billId, rentalId)
activate Builder

BillMgr -> Builder : .baseRentalFee(fee)
BillMgr -> Builder : .discountAmount(disc)
BillMgr -> Builder : .latePenalty(latePenalty)
BillMgr -> Builder : .damagePenalty(damagePenalty)

BillMgr -> Builder : .build()
Builder --> BillMgr : return Bill
deactivate Builder

|||
' Persist bill
BillMgr -> DS : saveBill()
activate DS
DS --> BillMgr : saved
deactivate DS

BillMgr --> Facade : return bill
deactivate BillMgr

Facade --> Ctrl : return bill
deactivate Facade

Ctrl --> View : return bill
deactivate Ctrl

note over View : displayBill(bill)\nshow breakdown:\nbase fee, discount,\npenalty, net payable
View --> Actor : render itemized bill breakdown
deactivate View

@enduml